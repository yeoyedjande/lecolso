APP_NAME="EKALEWA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Stockage en UTC (config/app.php), affichage dans le fuseau ci-dessous
APP_DISPLAY_TIMEZONE=Africa/Abidjan
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Rôle applicatif, soumis à la RLS (docker/postgres/init/01-roles.sql)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gestion_ecole
DB_USERNAME=app_user
DB_PASSWORD=app_user_secret

# Rôle super-admin (BYPASSRLS), connexion séparée pgsql_platform : service api uniquement
DB_PLATFORM_USERNAME=app_platform
DB_PLATFORM_PASSWORD=app_platform_secret

# Rôle propriétaire des tables, réservé aux migrations (connexion pgsql_owner)
DB_OWNER_USERNAME=app_owner
DB_OWNER_PASSWORD=app_owner_secret

# Authentification SPA par cookie httpOnly (Sanctum) : sessions Redis
SESSION_DRIVER=redis
# Minutes d'inactivité (8 h, personnel). « Se souvenir de moi » (comptes sans rôle du personnel) : 30 jours
SESSION_LIFETIME=480
# Domaine principal en production (.exemple.ci) ; vide en local
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Frontend autorisé (CORS avec cookies) et domaines « stateful » de Sanctum
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173
# Production : pages des écoles <slug>.<domaine>, ex. #^https://[a-z0-9-]+\.exemple\.ci$#
CORS_ALLOWED_ORIGIN_PATTERN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Préfixes figés (sinon dérivés d'APP_NAME : changer le nom affiché viderait sessions, cache et files)
REDIS_PREFIX=gestion-ecole-database-
CACHE_PREFIX=gestion-ecole-cache-
HORIZON_PREFIX=gestion_ecole_horizon:

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Rendu PDF (Gotenberg) ; vide hors Docker : rendu factice hors production
GOTENBERG_URL=
