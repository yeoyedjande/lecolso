APP_NAME="Gestion Ecole"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Stockage en UTC (config/app.php), affichage dans le fuseau ci-dessous
APP_DISPLAY_TIMEZONE=Africa/Abidjan
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Rôle applicatif, soumis à la RLS (docker/postgres/init/01-roles.sql)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gestion_ecole
DB_USERNAME=app_user
DB_PASSWORD=app_user_secret

# Rôle super-admin (BYPASSRLS), connexion séparée pgsql_platform : service api uniquement
DB_PLATFORM_USERNAME=app_platform
DB_PLATFORM_PASSWORD=app_platform_secret

# Rôle propriétaire des tables, réservé aux migrations (connexion pgsql_owner)
DB_OWNER_USERNAME=app_owner
DB_OWNER_PASSWORD=app_owner_secret

# API à tokens Sanctum : pas de session serveur
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
