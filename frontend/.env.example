# URL de base de l'API (préfixe /api/v1 compris). Fixée au build sur Railway.
VITE_API_URL=http://localhost:8080/api/v1
# local | staging | production : la page /design n'existe pas en production
VITE_APP_ENV=local
# Données de démonstration pour les modules sans backend (élèves, paiements, notes…)
VITE_DEMO_MODULES=true
# Domaine des sous-domaines d'école : sur <slug>.<domaine>, l'établissement est présélectionné (vide en local)
VITE_TENANT_DOMAIN=
